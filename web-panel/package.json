{
  "name": "all2api-web-panel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "all2api 自托管面板前端。M0 落冻结契约消费件（ConsentGate / ThrottleForm / AdvancedToggle）；M2 B1 起落构建管道（build → web-panel/dist，由 CI / Dockerfile 搬运进 internal/web/dist 供网关 go:embed；build:embed 是本机等价物）。",
  "scripts": {
    "build": "vite build",
    "build:embed": "vite build && node -e \"const fs=require('node:fs');fs.mkdirSync('../internal/web/dist',{recursive:true});fs.cpSync('dist','../internal/web/dist',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.4"
  }
}
