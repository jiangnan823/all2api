# Build context exclusions for the all2api image.
# Keeping this tight matters: `COPY . .` is what makes the build cache leaky.

.git
.gitignore
.github
.idea
.vscode
.qoder
.qoder-collab-runtime
.qoder-sop-runtime
# Nested local git worktrees hold full duplicate source trees (incl. node_modules);
# they must never enter the build context or get pulled in by `COPY . .`.
.worktrees/
.worktree/

# Runtime state must never be baked into an image — these hold credentials.
auths/
data/
*.jwt
*.token
secrets/
.env
.env.*

# Local build output
dist/
out/
staging/
bin/
*.exe
*.test
*.out
coverage.out
vendor/

# Panel sources are compiled in the `web` stage; the Go stage only needs the bundle it produces.
# `web-panel/dist` is excluded on purpose: with `emptyOutDir: false` a host-side stale bundle
# would be copied into the stage and survive alongside the fresh one, so the image could embed
# dead hashed assets while every assertion still counted "real files present". The stage must be
# the only producer of the bundle it moves into internal/web/dist.
web-panel/node_modules
web-panel/dist
web-panel/.next
web-panel/tmp
web-panel/coverage
web-panel/.vite

# Belt-and-braces for the `dist/` rule above: go:embed all:dist fails at compile time
# if the embed dir (or its .gitkeep placeholder) is ever filtered out of the context.
!internal/web/dist/
!internal/web/dist/**

# Docs / deploy assets not needed to build the binary
deploy/
docs/
*.md
LICENSE
Makefile
docker-compose*.yml
